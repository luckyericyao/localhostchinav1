# Use a real, monitored inbox when Resend is not configured.
LOCALHOST_CONTACT_EMAIL=
LOCALHOST_RESPONSE_WINDOW=within two working days
# Optional overrides for the owner-approved Eric Yao contact profile.
# Publish a biography only after it has been approved; none is invented by default.
LOCALHOST_OPERATOR_NAME=
LOCALHOST_OPERATOR_BIO=
# Internal reviewer alias, not a traveler email or public biography.
LOCALHOST_REVIEW_OWNER=
# China-local dates excluded from the Monday-Friday reply calendar.
LOCALHOST_REVIEW_HOLIDAYS=

# Server-only Resend configuration. Never expose these as NEXT_PUBLIC_ variables.
RESEND_API_KEY=
# Use an address on a Resend-verified sending domain.
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Optional anonymous session-level funnel persistence. No email or inquiry content is sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
