LOCALHOST_CONTACT_EMAIL=hello@localhostglobal.com
LOCALHOST_RESPONSE_WINDOW=within two working days

# Server-only Resend configuration. Never expose these as NEXT_PUBLIC_ variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Localhost Global <inquiry@localhostglobal.com>
RESEND_TO_EMAIL=

# Optional anonymous session-level funnel persistence. No email or inquiry content is sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
